{
  "name": "dwstore-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Lankan electronics eCommerce platform (Storefront, Admin, API)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:admin": "pnpm --filter admin dev",
    "whatsapp": "pnpm --filter whatsapp-gateway start",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint"
  },
  "packageManager": "pnpm@12.15.0"
}
