datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Authentication & RBAC
// -------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  CONTENT_EDITOR
  CUSTOMER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  orders        Order[]
  importJobs    ImportJob[]
  exportJobs    ExportJob[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// -------------------------------------------------------------
// Catalog: Categories & Brands
// -------------------------------------------------------------
model Category {
  id          String     @id @default(uuid())
  parentId    String?
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    ProductCategory[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("brands")
}

// -------------------------------------------------------------
// Catalog: Products & Variants
// -------------------------------------------------------------
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

model Product {
  id               String        @id @default(uuid())
  type             ProductType   @default(SIMPLE)
  name             String
  slug             String        @unique
  shortDescription String?       @db.Text
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  brandId          String?
  seoTitle         String?
  seoDescription   String?       @db.Text
  sourceSystem     String?       // "woocommerce"
  sourceId         String?       // original WooCommerce ID
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand            Brand?        @relation(fields: [brandId], references: [id])
  categories       ProductCategory[]
  variants         ProductVariant[]
  images           ProductMedia[]

  @@index([sourceSystem, sourceId])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  sku             String   @unique
  title           String   // e.g. "Natural Titanium / 256GB" or default "Standard"
  priceMinor      Int      // LKR cents
  compareAtMinor  Int?     // Regular price before sale in LKR cents
  weightGrams     Int?
  isActive        Boolean  @default(true)
  sourceSystem    String?
  sourceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       Inventory?
  images          ProductMedia[]
  orderItems      OrderItem[]

  @@index([sourceSystem, sourceId])
  @@map("product_variants")
}

// -------------------------------------------------------------
// Inventory Ledger
// -------------------------------------------------------------
model Inventory {
  id                String         @id @default(uuid())
  variantId         String         @unique
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  version           Int            @default(1)
  updatedAt         DateTime       @updatedAt

  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id          String    @id @default(uuid())
  inventoryId String
  quantity    Int       // Positive (restock) or negative (fulfilled/adjustment)
  reason      String    // "INITIAL_IMPORT", "ORDER_RESERVED", "ORDER_FULFILLED", "MANUAL_ADJUSTMENT"
  referenceId String?   // Order ID or Import ID
  createdAt   DateTime  @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

// -------------------------------------------------------------
// Media & Object Storage Assets
// -------------------------------------------------------------
enum MediaDownloadStatus {
  PENDING
  SUCCESS
  FAILED
}

model MediaAsset {
  id             String              @id @default(uuid())
  storageKey     String?             // Path in S3 / CDN
  sourceUrl      String              @unique
  checksumSha256 String?
  mimeType       String?
  width          Int?
  height         Int?
  bytes          Int?
  downloadStatus MediaDownloadStatus @default(PENDING)
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  productMedia   ProductMedia[]

  @@map("media_assets")
}

model ProductMedia {
  id           String          @id @default(uuid())
  productId    String
  variantId    String?
  mediaAssetId String
  sortOrder    Int             @default(0)
  isPrimary    Boolean         @default(false)
  altText      String?

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

// -------------------------------------------------------------
// Orders & Checkout
// -------------------------------------------------------------
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  PAYHERE
  KOKO
  MINTPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // e.g. DW-2026-1001
  userId          String?
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String        @db.Text
  city            String
  district        String
  province        String
  orderStatus     OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotalMinor   Int
  shippingMinor   Int           @default(0)
  discountMinor   Int           @default(0)
  totalMinor      Int
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User?         @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String         @id @default(uuid())
  orderId      String
  variantId    String
  productName  String         // Snapshot
  variantTitle String         // Snapshot
  sku          String         // Snapshot
  priceMinor   Int            // Snapshot in cents
  quantity     Int
  totalMinor   Int

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// -------------------------------------------------------------
// WooCommerce CSV Migration & Import Subsystem (Mandatory)
// -------------------------------------------------------------
enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ImportJob {
  id                 String       @id @default(uuid())
  createdById        String?
  filename           String
  fileSha256         String
  sourceType         String       @default("woocommerce")
  mode               String       @default("upsert") // dry_run, upsert, create_only
  status             ImportStatus @default(PENDING)
  totalRows          Int          @default(0)
  processedRows      Int          @default(0)
  createdCount       Int          @default(0)
  updatedCount       Int          @default(0)
  skippedCount       Int          @default(0)
  failedCount        Int          @default(0)
  imageSuccessCount  Int          @default(0)
  imageFailureCount  Int          @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  reportStorageKey   String?
  createdAt          DateTime     @default(now())

  createdBy          User?        @relation(fields: [createdById], references: [id])
  rows               ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String       @id @default(uuid())
  importJobId          String
  rowNumber            Int
  sourceId             String?
  sourceType           String?      // simple, variable, variation
  sourceParentId       String?
  normalizedJson       Json?
  validationErrorsJson Json?
  targetProductId      String?
  targetVariantId      String?
  status               String       @default("PENDING") // PENDING, SUCCESS, FAILED, NEEDS_REVIEW
  createdAt            DateTime     @default(now())

  importJob            ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber])
  @@map("import_rows")
}

model ExternalProductMapping {
  id              String   @id @default(uuid())
  sourceSystem    String   // "woocommerce"
  sourceId        String   // WooCommerce ID
  entityType      String   // "product" or "variant"
  localId         String   // target Product or Variant ID
  lastImportHash  String?
  lastSeenAt      DateTime @default(now())

  @@unique([sourceSystem, sourceId])
  @@map("external_product_mappings")
}

model ExportJob {
  id          String   @id @default(uuid())
  createdById String?
  format      String   @default("native_csv") // native_csv, woocommerce_csv
  filtersJson Json?
  status      String   @default("PENDING")
  fileKey     String?
  rowCount    Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@map("export_jobs")
}
