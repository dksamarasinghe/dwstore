# ==========================================
# DWstore Production Environment Variables
# Timezone: Asia/Colombo | Currency: LKR
# ==========================================

# 1. Node Environment
NODE_ENV=production
PORT=3000

# 2. Database (PostgreSQL 16)
POSTGRES_USER=dwstore
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=dwstore_production
DATABASE_URL=postgresql://dwstore:your_secure_postgres_password_here@postgres:5432/dwstore_production?schema=public

# 3. Security & Authentication
JWT_SECRET=generate_a_secure_random_64_char_string
SESSION_SECRET=generate_another_secure_session_secret

# 4. URLs & Domains
STOREFRONT_URL=https://www.dwstore.lk
ADMIN_URL=https://admin.dwstore.lk
API_URL=https://api.dwstore.lk

# 5. Sri Lankan Payment Gateways (Optional)
# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_MODE=sandbox

# KOKO BNPL
KOKO_API_KEY=
KOKO_MERCHANT_ID=

# Payzy
PAYZY_API_KEY=

# 6. S3-Compatible Object Storage (Cloudflare R2 / Hetzner Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=dwstore-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_CDN_URL=https://media.dwstore.lk

# 7. Resend Email Service (https://resend.com - Free 3,000 emails/mo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=DWstore.lk <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=support@dwstore.lk

# 8. Automated WhatsApp Business Notifications (Optional)
# Option A: Meta WhatsApp Cloud API
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Option B: Self-Hosted Free Gateway (Baileys / Evolution API)
# WHATSAPP_GATEWAY_URL=http://localhost:8080/send
# WHATSAPP_GATEWAY_API_KEY=
